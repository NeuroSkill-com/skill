{
  "extends": "$app/tsconfig",
  "include": ["src", "test", "*"],
  // test.ts is the standalone API smoke script (run by scripts/smoke-test.sh
  // via tsx); the type-check never covered it.
  "exclude": ["src/service-worker", "test.ts"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    // `#lib` comes from package.json "imports" (SvelteKit 3 dropped `$lib`).
    // TypeScript maps "imports" targets literally and never tries extensions,
    // so the extensionless `#lib/foo` imports also need this path mapping.
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"]
    }
  }
  // SvelteKit 3: `$app/tsconfig` carries the generated types. The
  // include/exclude above are the ones `svelte-kit sync` asks for.
}
