diff --git a/scripts/check-webbluetooth-lockstep.sh b/scripts/check-webbluetooth-lockstep.sh
new file mode 100755
index 0000000..2c7f9c8
--- /dev/null
+++ b/scripts/check-webbluetooth-lockstep.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# ── Fail if Cargo.lock holds more than one version of any webbluetooth crate ──
+#
+# Usage:
+#   bash scripts/check-webbluetooth-lockstep.sh [path/to/Cargo.lock]
+#
+# Two versions of webbluetooth in one graph = two `Bluetooth::shared()`
+# sessions = two CBCentralManagers = devices that will not connect (see the
+# lockstep note in the workspace Cargo.toml).  `cargo tree -i webbluetooth`
+# only resolves the host target, so it misses a stale `webbluetooth-wasm`
+# asked for under `cfg(target_arch = "wasm32")`.  Cargo.lock is resolved for
+# every target at once, so counting versions there catches both.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+LOCK="${1:-$ROOT/Cargo.lock}"
+
+[[ -f "$LOCK" ]] || { echo "error: $LOCK not found" >&2; exit 2; }
+
+# "name version" for every webbluetooth / webbluetooth-* package in the lock.
+pairs="$(awk '
+  /^\[\[package\]\]/ { name = "" }
+  /^name = /         { gsub(/"/, "", $3); name = $3 }
+  /^version = / && name ~ /^webbluetooth(-[a-z0-9]+)?$/ { gsub(/"/, "", $3); print name, $3 }
+' "$LOCK" | sort -u)"
+
+if [[ -z "$pairs" ]]; then
+  echo "error: no webbluetooth packages in $LOCK" >&2
+  exit 2
+fi
+
+split="$(awk '{ print $1 }' <<<"$pairs" | uniq -d)"
+if [[ -n "$split" ]]; then
+  echo "error: webbluetooth is split — more than one version of:" >&2
+  for name in $split; do
+    echo "  $name: $(awk -v n="$name" '$1 == n { printf "%s ", $2 }' <<<"$pairs")" >&2
+  done
+  echo "Every BLE crate must move to the same webbluetooth 0.0.x together;" >&2
+  echo "find the stragglers with:  cargo tree --target all -i <name>@<old version>" >&2
+  exit 1
+fi
+
+versions="$(awk '{ print $2 }' <<<"$pairs" | sort -u | tr '\n' ' ')"
+echo "webbluetooth lockstep OK: $(wc -l <<<"$pairs" | tr -d ' ') crates, version ${versions% }"
