{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroSkill",
  "version": "0.0.131-rc.20",
  "identifier": "com.neuroskill.skill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "NeuroSkill™",
        "width": 480,
        "height": 800,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https:; img-src 'self' data: blob: asset: http://asset.localhost http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; worker-src 'self' blob:; media-src 'self' blob: data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "resources": {
      "resources/neutts-samples": "neutts-samples",
      "resources/tts/inflect-nano": "tts/inflect-nano"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQUVEMjRERUVDRDUzNEUKUldST1U4M3VUZEt1b3pGL0J2TUdlRmR5d1FBOExLZkZPcm9EODRyakxVTnFsY3JuY3BZaHB0ZmEK",
      "endpoints": [
        "https://github.com/NeuroSkill-com/skill/releases/latest/download/latest.json"
      ],
      "hooks": {
        "pre-update": "../hooks/pre-update.cjs",
        "post-update": "../hooks/post-update.cjs"
      }
    }
  }
}
