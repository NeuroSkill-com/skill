{
  "name": "neuroskill",
  "private": true,
  "description": "",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch{}\"",
    "dev": "npm run -s dev:guard && npm run -s build:settings-index && vite dev",
    "build": "npm run -s dev:guard && npm run -s build:settings-index && svelte-kit sync && vite build && npm run -s verify:tauri:frontend",
    "preview": "vite preview",
    "dev:guard": "node scripts/check-rust-version.mjs && node scripts/check-markdown-renderer.js",
    "build:settings-index": "tsx scripts/build-settings-index.ts",
    "build:viz3d": "bash scripts/build-viz3d.sh",
    "test": "node scripts/check.mjs",
    "test:watch": "vitest",
    "test:ui": "playwright test --reporter=list",
    "test:llm:daemon-e2e": "python3 scripts/llm-daemon-e2e/run_one.py",
    "test:device-health": "python3 scripts/device-health-scenarios.py",
    "check": "node scripts/check-markdown-renderer.js && node scripts/check-daemon-invokes.js && node scripts/check-typed-daemon-clients.js && node scripts/check-settings-font-sizes.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run -s dev:guard && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore src-tauri --watch",
    "check:cross": "node scripts/check-cross.js",
    "lint": "npx biome check src/ scripts/",
    "lint:fix": "npx biome check --write src/ scripts/",
    "format": "npx biome format --write src/ scripts/",
    "sync:i18n": "tsx scripts/sync-i18n.ts",
    "sync:i18n:fix": "tsx scripts/sync-i18n.ts --fix",
    "audit:i18n": "tsx scripts/audit-i18n.ts",
    "audit:a11y": "node scripts/audit-a11y.js",
    "sync:llm:catalog": "node scripts/sync-llm-catalog.js --write",
    "sync:hf:downloads": "node scripts/update-hf-downloads-cache.mjs --write",
    "sync:readme:supported": "node scripts/sync-readme-supported.js",
    "audit:daemon-routes": "node scripts/audit-daemon-routes.js",
    "health": "node scripts/health.mjs",
    "changes:new": "node scripts/new-changelog-fragment.js",
    "check:changelog:fix": "node scripts/check-changelog-fragments.js --fix",
    "tauri": "node scripts/tauri-build.js",
    "tauri:build": "node scripts/tauri-build.js build",
    "tauri:flamegraph": "node scripts/tauri-flamegraph.js",
    "dist:mac": "node scripts/tauri-build.js build --no-bundle && bash scripts/assemble-macos-app.sh && bash scripts/create-macos-dmg.sh",
    "dist:win": "node scripts/tauri-build.js build --no-bundle && powershell -ExecutionPolicy Bypass -File scripts/create-windows-nsis.ps1",
    "dist:linux": "bash scripts/package-linux-dist.sh",
    "dist:linux:system": "bash scripts/package-linux-system-bundles.sh",
    "verify:tauri:frontend": "node scripts/verify-tauri-frontend-structure.js",
    "verify:rpm": "bash scripts/verify-rpm-docker.sh",
    "brew:cask:generate": "bash scripts/generate-homebrew-cask.sh",
    "ci:dry-run": "node scripts/ci.mjs dry-run-release",
    "bump": "node scripts/bump.js",
    "tag": "node scripts/tag.js",
    "release": "node scripts/release.js",
    "rlx": "bash scripts/rlx",
    "daemon": "tsx scripts/daemon.ts",
    "stop": "node scripts/stop-daemon.mjs",
    "skill": "tsx neuroskill/cli.ts",
    "neuroskill": "cd neuroskill && npm ci && npm run build && node dist/bin/neuroskill.js",
    "neuroloop": "cd neuroloop && npm run build && node dist/neuroloop.js",
    "screenshots": "node scripts/screenshots/take-screenshots.mjs",
    "gifs": "node scripts/screenshots/take-gifs.mjs",
    "bench:screenshot": "cargo run --release -p skill-screenshots --bin image_encode_bench",
    "copy:neutts-samples": "bash scripts/copy-neutts-samples.sh",
    "setup": "bash scripts/setup-dev.sh",
    "setup:build-cache": "bash scripts/setup-build-cache.sh",
    "pull": "git pull && git submodule update --init --recursive",
    "clean": "npm run -s clean:deps && npm run -s clean:rust",
    "clean:deps": "node scripts/clean.js",
    "clean:rust": "node scripts/clean-rust.js",
    "clean:rust:debug": "node scripts/slim-target.js"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@types/d3": "^7.4.3",
    "bits-ui": "^2.16.2",
    "d3": "^7.9.0",
    "maplibre-gl": "^6.16.0",
    "marked": "^18.0.0",
    "mdsvex": "^1.0.1",
    "pmtiles": "^4.4.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2",
    "@types/ws": "^8.18.1",
    "bonjour-service": "^1.3.0",
    "esbuild": "^0.28.1",
    "gif-encoder-2": "^1.0.5",
    "playwright": "^1.58.2",
    "sharp": "^0.35.5",
    "svelte": "^5.58.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.1.1",
    "ws": "^8.21.1"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "deepmerge": "file:./patches/npm/deepmerge-4.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
