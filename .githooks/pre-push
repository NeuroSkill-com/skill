#
# Pre-push: the `push` tier of scripts/check.mjs — the full check list, scoped
# to what this push changes. PREPUSH_FULL=1 runs the unscoped `full` tier.
# Bypass once with `git push --no-verify`.

set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi

if [ "${PREPUSH_FULL:-0}" = "1" ]; then
  exec node scripts/check.mjs full
fi
exec node scripts/check.mjs push
