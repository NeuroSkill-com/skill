#
# Pre-commit: the `commit` tier of scripts/check.mjs — staged files only, a few
# seconds. Run it by hand with `npm test -- commit`; list it with `npm test -- --list`.

set -euo pipefail

# GUI git clients start hooks without the login shell's PATH.
if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
elif [ -d "$HOME/.cargo/bin" ]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

exec node scripts/check.mjs commit
